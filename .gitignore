# OS
.DS_Store

# Node
node_modules/
dist/
build/
# excecao: produtos empacotados do Ray Audio Driver sao commiteis
# (driver/scripts/verify-driver.sh resolve os produtos antes do build, T-500)
!driver/ray-audio-driver/build/
# diretorio de build do SwiftPM do driver (regerado pelo gate, nunca commitado)
driver/ray-audio-driver/.build/

# Rust / Tauri
/core/target/
/apps/*/src-tauri/target/
# ts-rs default export path when not yet wired to contracts/ipc.ts (ADR-010, T-000)
/bindings/
/core/bindings/
# tauri_build::build() capability-schema output (core/build.rs)
/core/gen/

# Prisma
prisma/*.db

# Env
.env
.env.local
