{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ray",
  "version": "0.0.0",
  "identifier": "com.ray.app",
  "build": {
    "beforeDevCommand": "npm --prefix apps/ui run dev",
    "beforeBuildCommand": "npm --prefix apps/ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "appbar",
        "title": "Ray",
        "url": "/",
        "width": 940,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "center": true
      },
      {
        "label": "main",
        "title": "Ray",
        "url": "/",
        "width": 900,
        "height": 640,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ray-sidecar"],
    "targets": ["appimage", "deb", "dmg", "msi"],
    "resources": [
      "resources/whisper/whisper-main",
      "resources/whisper/ggml-tiny.bin"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.ray.app/{{target}}/{{arch}}/{{current_version}}/stable",
        "https://releases.ray.app/{{target}}/{{arch}}/{{current_version}}/unstable"
      ],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
