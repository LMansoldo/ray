{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ray",
  "version": "0.0.0",
  "identifier": "com.ray.app",
  "build": {
    "beforeDevCommand": "npm --prefix apps/ui run dev",
    "beforeBuildCommand": "npm --prefix apps/ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ray",
        "url": "/",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ray-sidecar"],
    "targets": ["appimage", "deb", "dmg", "msi"],
    "resources": [
      "resources/whisper/whisper-main",
      "resources/whisper/ggml-tiny.bin"
    ]
  }
}
